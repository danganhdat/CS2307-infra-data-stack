# Rendered by scripts/render.sh (envsubst substitutes ${DOMAIN} only;
# nginx runtime variables like $host are left untouched).

events {}

http {
  include       /etc/nginx/mime.types;
  default_type  application/octet-stream;
  sendfile      on;
  server_tokens off;

  # HTTP: serve the ACME challenge, redirect everything else to HTTPS.
  server {
    listen 80;
    server_name neo4j.${DOMAIN} console.${DOMAIN} s3.${DOMAIN};

    location /.well-known/acme-challenge/ {
      root /var/www/certbot;
    }
    location / {
      return 301 https://$host$request_uri;
    }
  }

  # Neo4j Browser
  server {
    listen 443 ssl;
    server_name neo4j.${DOMAIN};
    ssl_certificate     /etc/letsencrypt/live/data-stack/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/data-stack/privkey.pem;

    location / {
      proxy_pass http://neo4j:7474;
      proxy_set_header Host              $host;
      proxy_set_header X-Real-IP         $remote_addr;
      proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }
  }

  # MinIO Console
  server {
    listen 443 ssl;
    server_name console.${DOMAIN};
    ssl_certificate     /etc/letsencrypt/live/data-stack/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/data-stack/privkey.pem;

    ignore_invalid_headers off;
    client_max_body_size 0;
    proxy_buffering off;
    proxy_request_buffering off;

    location / {
      proxy_pass http://minio:9001;
      proxy_set_header Host              $host;
      proxy_set_header X-Real-IP         $remote_addr;
      proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_http_version 1.1;
      proxy_set_header Upgrade    $http_upgrade;
      proxy_set_header Connection "upgrade";
      chunked_transfer_encoding off;
    }
  }

  # MinIO S3 API
  server {
    listen 443 ssl;
    server_name s3.${DOMAIN};
    ssl_certificate     /etc/letsencrypt/live/data-stack/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/data-stack/privkey.pem;

    ignore_invalid_headers off;
    client_max_body_size 0;          # allow large object uploads
    proxy_buffering off;
    proxy_request_buffering off;

    location / {
      proxy_pass http://minio:9000;
      proxy_set_header Host              $host;
      proxy_set_header X-Real-IP         $remote_addr;
      proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_connect_timeout 300;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
    }
  }
}

# Bolt over TLS so Neo4j Browser (loaded over HTTPS) can connect with
# neo4j+s://neo4j.${DOMAIN}:7687. nginx terminates TLS, forwards plaintext
# to Neo4j on the internal network.
stream {
  server {
    listen 7687 ssl;
    ssl_certificate     /etc/letsencrypt/live/data-stack/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/data-stack/privkey.pem;
    proxy_pass neo4j:7687;
  }
}
